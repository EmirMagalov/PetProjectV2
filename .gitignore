# pyenv
#   For a library or package, you might want to ignore these files since they are
#   intended to be local
# .python-version

# pipenv
#   Relying on Pipenv to have a Pipfile.lock, but you might want to
#   overwrite it in a local development environment
# pipfile.lock

# poetry
#   Similar to Pipfile.lock, it's generally a good idea to check in poetry.lock, but you could
#   ignore it.
# poetry.lock

# pdm
#   Similar to Poetry, it's generally a good idea to check in pdm.lock
.pdm.toml
